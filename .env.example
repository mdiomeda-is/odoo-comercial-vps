# ============================================================================
#  ODOO 19 COMERCIAL en VPS nuevo (Coolify)  ·  Intellia Solution
#  Valores de referencia. En Coolify, las variables del stack (POSTGRES_*) se
#  cargan en la sección "Environment Variables" del recurso. Las de empresa
#  (COMPANY_*) se usan al correr la preconfiguración por terminal.
#  Poné TODOS los valores entre "comillas dobles".
# ============================================================================

# ---------- Dominio ----------
ODOO_DOMAIN="odoo.tudominio.com"          # el que vas a poner en Coolify

# ---------- PostgreSQL (van en Environment Variables del stack en Coolify) ----------
POSTGRES_USER="odoo"
POSTGRES_PASSWORD="CAMBIAME_pg"           # openssl rand -base64 24

# ---------- Odoo (base + admin para la preconfiguración) ----------
ODOO_DB_NAME="comercial"                  # coincide con dbfilter de config/odoo.conf
ODOO_ADMIN_LOGIN="admin@tudominio.com"
ODOO_ADMIN_PASSWORD="CAMBIAME_admin"      # openssl rand -base64 18
ODOO_BASE_URL="https://odoo.tudominio.com"   # URL pública real (https) -> links internos

# ---------- Empresa (preconfiguración) ----------
COMPANY_NAME="Tu Empresa S.A."
COMPANY_VAT="30-12345678-9"
COMPANY_STREET="Calle 123"
COMPANY_CITY="Buenos Aires"
COMPANY_ZIP="1000"
COMPANY_STATE="Buenos Aires"
COMPANY_COUNTRY_CODE="AR"
COMPANY_PHONE="+54 11 4000-0000"
COMPANY_EMAIL="info@tuempresa.com"
COMPANY_WEBSITE="https://tuempresa.com"
COMPANY_CURRENCY="ARS"
COMPANY_LANG="es_AR"
COMPANY_TZ="America/Argentina/Buenos_Aires"

# ---------- Módulos a instalar (Odoo 19 + AFIP de ADHOC 19.0) ----------
# AFIP en 19 = 'l10n_ar_fiscal_ws' (reemplaza al l10n_ar_afipws_fe de 18).
ODOO_INIT_MODULES="base,contacts,crm,sale_management,account,l10n_ar,purchase,stock,project,l10n_ar_fiscal_ws"
